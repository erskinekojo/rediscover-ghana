---
import Icon from './Icon.astro';
// Opens a dialog with the video embed. Until a real film URL is in the content file it shows a clear placeholder.
interface Props { id: string; label: string; title: string; url?: string; class?: string; fill?: string }
const { id, label, title, url = '', class: cls = 'btn btn-primary', fill = '#fff' } = Astro.props;
---
<button type="button" class={cls} data-watch={`dlg-${id}`}>
  <Icon name="play" size={16} fill={fill} stroke="none" />{label}
</button>
<dialog id={`dlg-${id}`} class="watch-dialog" aria-label={title}>
  <form method="dialog" class="watch-bar">
    <strong>{title}</strong>
    <button class="icon-btn" aria-label="Close video"><Icon name="close" /></button>
  </form>
  {url
    ? <iframe data-src={url} title={title} allow="accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe>
    : <div class="watch-empty"><p>Video placeholder</p><p class="muted">The finished film will play here. Add its YouTube or Vimeo embed URL to the content file.</p></div>}
</dialog>

<style is:global>
  .watch-dialog { width: min(92vw, 460px); padding: 0; border: none; border-radius: 20px; overflow: hidden; background: #171a16; color: #f6f4ee; }
  .watch-dialog::backdrop { background: rgba(23, 26, 22, 0.7); }
  .watch-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 10px 10px 18px; font-size: 14px; }
  .watch-dialog iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
  .watch-empty { aspect-ratio: 16 / 9; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 6px; padding: 16px; background: repeating-linear-gradient(135deg, #2b3d31 0 14px, #273829 14px 28px); }
  .watch-empty .muted { color: #c9d3c9; }
</style>

<script>
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-watch]');
    if (!b) return;
    const d = document.getElementById(b.dataset.watch!) as HTMLDialogElement | null;
    if (!d) return;
    const f = d.querySelector('iframe');
    if (f && !f.src) f.src = f.dataset.src!;
    d.showModal();
  });
  document.addEventListener('close', (e) => {
    const d = e.target as HTMLElement;
    if (d instanceof HTMLDialogElement) { const f = d.querySelector('iframe'); if (f) f.removeAttribute('src'); }
  }, true);
</script>
