---
import '../styles/global.css';
import BottomNav from '../components/BottomNav.astro';
import { u } from '../lib/url';

interface Props { title: string; description?: string; nav?: 'discover' | 'map' | 'saved' | 'contribute' | '' }
const { title, description = 'Get to know Ghana, one town at a time. Documentary films, the stories of people, origin stories and verified visit guides.', nav = '' } = Astro.props;
const full = title === 'Rediscover Ghana' ? title : `${title} · Rediscover Ghana`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1E5B3A" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <link rel="manifest" href={u('/manifest.webmanifest')} />
    <link rel="icon" href={u('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/icon-192.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="app">
      <main class="page"><slot /></main>
      <BottomNav active={nav} />
    </div>
    <script is:inline define:vars={{ swUrl: u('/sw.js'), scope: u('/') }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register(swUrl, { scope }).catch(() => {}));
      }
    </script>
    <script>
      // "Saved" lives in localStorage: no accounts or backend in Phase 0.
      const KEY = 'rg:saved';
      type Item = { id: string; kind: string; title: string; href: string; sub: string };
      const read = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
      const write = (v: Item[]) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} };
      const sync = () => {
        const ids = new Set(read().map((i) => i.id));
        document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((b) => {
          const on = ids.has(b.dataset.saveId!);
          b.setAttribute('aria-pressed', String(on));
          b.setAttribute('aria-label', `${on ? 'Remove' : 'Save'} ${b.dataset.saveTitle}`);
        });
      };
      document.addEventListener('click', (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>('[data-save]');
        if (!b) return;
        e.preventDefault();
        const list = read();
        const id = b.dataset.saveId!;
        const next = list.some((i) => i.id === id)
          ? list.filter((i) => i.id !== id)
          : [...list, { id, kind: b.dataset.saveKind!, title: b.dataset.saveTitle!, href: b.dataset.saveHref!, sub: b.dataset.saveSub || '' }];
        write(next);
        sync();
        document.dispatchEvent(new CustomEvent('rg:saved-changed'));
      });
      sync();
    </script>
  </body>
</html>
