---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Ph from '../../../components/Ph.astro';
import WatchButton from '../../../components/WatchButton.astro';
import { filmedBundles } from '../../../lib/content';
import { u } from '../../../lib/url';

export function getStaticPaths() {
  return filmedBundles().map((b) => ({ params: { town: b.town.slug }, props: { b } }));
}
const { b } = Astro.props;
const t = b.town;
const primary = b.accounts.find((a) => a.isPrimary && a.type === 'oral');
const others = b.accounts.filter((a) => !a.isPrimary);
// "published …" dates read as-is; anything else is a recording date.
const when = (d: string) => (d.startsWith('published') ? d : `recorded ${d}`);
---
<Base title={`How ${t.name} began`}>
  <header class="topbar reveal">
    <a class="icon-btn" href={u(`/towns/${t.slug}/`)} aria-label={`Back to ${t.name}`}><Icon name="back" /></a>
  </header>

  <section class="section reveal" style="padding-top:10px">
    <p class="label">{t.name} · Chapter 1</p>
    <h1 class="title">How {t.name} began</h1>
    {t.draftNote && <p class="notice">{t.draftNote}</p>}
  </section>

  <section class="section reveal" style="padding-top:18px">
    <Ph aria="Video clip: the elder tells the story in Ga, with subtitles" label="Clip · In Ga, with subtitles" color="#24352B" class="video-clip">
      <WatchButton id="clip" label="The story in his own words · [3:20]" title={`How ${t.name} began`} class="btn btn-gold" fill="#171A16" />
    </Ph>
  </section>

  <section class="section reveal" style="padding-top:20px">
    <div class="name-card">
      <p class="label">The name</p>
      <p class="name-ga">{t.name} · {b.nameCard.ga}</p>
      <p class="body-copy">{b.nameCard.meaning}</p>
    </div>
  </section>

  {primary && (
    <section class="section reveal" style="padding-top:28px">
      <span class="badge oral" style="align-self:flex-start">Oral tradition</span>
      <p class="muted">As told by {primary.toldBy}, {primary.role} · {when(primary.recordedDate)}</p>
      <p style="font-size:16.5px;line-height:1.65;color:var(--body)">{primary.text}</p>
      {primary.quote && <blockquote class="pull" style="margin-top:8px">“{primary.quote}”</blockquote>}
      {primary.quoteGa && <p class="ga-quote">Original in Ga: “{primary.quoteGa}”</p>}
    </section>
  )}

  {others.map((a) => (
    <section class="section reveal" style="padding-top:28px">
      <div class="card">
        <h2 class="h2">Another account</h2>
        <span class:list={['badge', a.type]} style="align-self:flex-start">{a.type === 'oral' ? 'Oral tradition' : 'Written history'}</span>
        <p class="muted">{a.type === 'oral' ? 'As told by' : 'From'} {a.toldBy}, {a.role} · {when(a.recordedDate)}</p>
        <p class="body-copy" style="font-size:16px">{a.text}</p>
      </div>
    </section>
  ))}

  <section class="section reveal" style="padding-top:16px">
    <div class="card">
      <h2 class="h2">What the written record says</h2>
      <span class="badge written" style="align-self:flex-start">Written history</span>
      <p class="body-copy" style="font-size:16px">{b.writtenRecord}</p>
    </div>
  </section>

  <section id="sources" class="section sources reveal">
    <h2 class="h2">Sources</h2>
    <ol>{b.sources.map((s) => <li>{s.citation}</li>)}</ol>
  </section>

  <Fragment slot="bar">
    <button type="button" class="dock-share" data-share data-share-title={`How ${t.name} began`} aria-label="Share this story"><Icon name="share" /></button>
    <a class="btn dock-cta" href={u(`/contribute/?topic=version&town=${t.slug}`)}>Know a different version? Tell us</a>
  </Fragment>
</Base>
