---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Ph from '../../../components/Ph.astro';
import WatchButton from '../../../components/WatchButton.astro';
import { filmedBundles } from '../../../lib/content';
import { u } from '../../../lib/url';

export function getStaticPaths() {
  return filmedBundles().map((b) => ({ params: { town: b.town.slug }, props: { b } }));
}
const { b } = Astro.props;
const t = b.town;
const primary = b.accounts.find((a) => a.isPrimary && a.type === 'oral');
const others = b.accounts.filter((a) => !a.isPrimary && a.type === 'oral');
---
<Base title={`How ${t.name} began`} nav="discover">
  <header class="topbar">
    <a class="icon-btn" href={u(`/towns/${t.slug}/`)} aria-label={`Back to ${t.name}`}><Icon name="back" /></a>
  </header>

  <section class="section" style="padding-top:8px">
    <p class="label">{t.name} · Chapter 1</p>
    <h1 class="title">How {t.name} began</h1>
    <Ph aria="Video clip: the elder tells the story in Ga, with subtitles" label="Clip · In Ga, with subtitles" striped color="#24352B" class="video-clip" style="border-radius:20px;height:220px;justify-content:space-between;padding:14px">
      <WatchButton id="clip" label="The story in his own words · [3:20]" title={`How ${t.name} began`} class="btn btn-gold" fill="#171A16" />
    </Ph>
  </section>

  <section class="section" style="padding-top:20px">
    <div class="name-card">
      <p class="label">The name</p>
      <p class="name-ga">{t.name} · {b.nameCard.ga}</p>
      <p class="body-copy">{b.nameCard.meaning}</p>
    </div>
  </section>

  {primary && (
    <section class="section" style="padding-top:24px">
      <span class="badge oral" style="align-self:flex-start">Oral tradition</span>
      <p class="muted">As told by {primary.toldBy}, {primary.role} · recorded {primary.recordedDate}</p>
      <p style="font-size:16px;line-height:1.6;color:var(--body)">{primary.text}</p>
      {primary.quote && <blockquote class="pull">“{primary.quote}”</blockquote>}
      {primary.quoteGa && <p class="ga-quote">Original in Ga: “{primary.quoteGa}”</p>}
    </section>
  )}

  {others.map((a) => (
    <section class="section" style="padding-top:24px">
      <h2 class="h2">Another account</h2>
      <span class="badge oral" style="align-self:flex-start">Oral tradition</span>
      <p class="muted">As told by {a.toldBy}, {a.role} · recorded {a.recordedDate}</p>
      <p class="body-copy" style="font-size:16px">{a.text}</p>
    </section>
  ))}

  <section class="section" style="padding-top:24px">
    <h2 class="h2">What the written record says</h2>
    <span class="badge written" style="align-self:flex-start">Written history</span>
    <p class="body-copy" style="font-size:16px">{b.writtenRecord}</p>
  </section>

  <section id="sources" class="section sources">
    <h2 class="h2">Sources</h2>
    <ol>{b.sources.map((s) => <li>{s.citation}</li>)}</ol>
  </section>

  <section class="pad" style="margin:28px 0">
    <a class="btn btn-outline" href={u(`/contribute/?topic=version&town=${t.slug}`)}>Know a different version? Tell us</a>
  </section>
</Base>
